{
  "name": "edenos-desktop",
  "productName": "edenOS",
  "version": "1.0.0",
  "description": "edenOS for Windows and Mac: a browser that mutes cursing and hides nudity as you watch.",
  "author": "jwmap3",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "node scripts/sync.js && electron .",
    "test": "node test/filters.test.js && node test/blocking.test.js",
    "dist:win": "node scripts/sync.js && electron-builder --win --publish never",
    "dist:mac": "node scripts/sync.js && electron-builder --mac --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "26.15.3",
    "onnxruntime-web": "1.30.0"
  },
  "build": {
    "appId": "com.safewatch.edenos.desktop",
    "productName": "edenOS",
    "copyright": "edenOS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "package.json",
      "build/icon.png",
      "src/**/*",
      "!src/**/*.map"
    ],
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "EdenOS-Setup.${ext}",
      "shortcutName": "edenOS",
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "artifactName": "EdenOS-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "edenOS"
    }
  }
}
